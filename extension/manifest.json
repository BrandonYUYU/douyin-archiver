{
  "manifest_version": 3,
  "name": "Douyin Liked / Favorites Archiver",
  "version": "0.1.0",
  "description": "Auto-scrolls your own Douyin 点赞/收藏 lists and archives every video URL plus metadata, exportable as JSON or CSV.",
  "minimum_chrome_version": "111",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "*://*.douyin.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Douyin Archiver",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "options_page": "pages/manage.html",

  "content_scripts": [
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["content/hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["content/content.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["lib/*.js"],
      "matches": ["*://*.douyin.com/*"]
    }
  ]
}
